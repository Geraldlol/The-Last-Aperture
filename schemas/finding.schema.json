{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://red-team-audit.dev/schemas/finding.schema.json",
  "title": "Red Team Audit candidate finding",
  "description": "An append-only candidate record accumulated through fan-out, triage, and proof.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "lens",
    "topic",
    "title",
    "claimed_impact_severity",
    "location",
    "evidence",
    "attack",
    "impact",
    "reachable_from",
    "confidence",
    "proof_plan"
  ],
  "properties": {
    "candidate_id": {
      "$ref": "#/$defs/candidateId"
    },
    "lens": {
      "$ref": "#/$defs/name"
    },
    "topic": {
      "$ref": "#/$defs/topic"
    },
    "title": {
      "$ref": "#/$defs/nonEmptyString",
      "maxLength": 512
    },
    "claimed_impact_severity": {
      "$ref": "#/$defs/severity"
    },
    "location": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 3,
            "pattern": "^.+:[1-9][0-9]*(?::[1-9][0-9]*)?$"
          },
          {
            "type": "string",
            "minLength": 3,
            "maxLength": 1024,
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}:(?!\\d+$).+$"
          }
        ]
      }
    },
    "cwe": {
      "type": "string",
      "pattern": "^CWE-[1-9][0-9]*$"
    },
    "evidence": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "source_anchors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/sourceAnchor"
      }
    },
    "quotes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/findingQuote" }
    },
    "absence_claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/absenceClaim" }
    },
    "attack": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "impact": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "reachable_from": {
      "$ref": "#/$defs/reachableFrom"
    },
    "contingent_fact": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "contingent_query": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "confidence": {
      "enum": [
        "High",
        "Medium",
        "Low"
      ]
    },
    "proof_plan": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "store_context": {
      "$ref": "#/$defs/storeContext"
    },
    "evidence_context": {
      "$ref": "#/$defs/evidenceContext"
    },
    "evidence_claim": {
      "enum": [
        "drift-from-source",
        "runtime-misconfiguration",
        "secret-present-in-artifact",
        "sensitive-data-at-rest",
        "unexpected-artifact-content",
        "vulnerable-component-present"
      ]
    },
    "principal_path": {
      "$ref": "#/$defs/principalPath"
    },
    "enforcement_plane": {
      "enum": [
        "application",
        "database",
        "cloud",
        "filesystem",
        "unknown"
      ]
    },
    "copy_path": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonEmptyString"
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      ]
    },
    "semantic_sensitivity": {
      "enum": [
        "stable",
        "version-sensitive",
        "deployment-sensitive"
      ]
    },
    "adapter_rule_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$"
    },
    "semantic_source": {
      "$ref": "#/$defs/semanticSource"
    },
    "effective_severity": {
      "$ref": "#/$defs/severity"
    },
    "triage_disposition": {
      "enum": [
        "queued",
        "merged",
        "dropped",
        "elevated"
      ]
    },
    "triage_authority": {
      "description": "Controller-stamped provenance for a provider's triage decision. This release exposes no authenticated triage authority.",
      "const": "UNAUTHENTICATED_PROVIDER_ASSERTION"
    },
    "drop_reason": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "raised_by": {
      "$ref": "#/$defs/name"
    },
    "component_finding_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/candidateId"
      }
    },
    "merged_into_candidate_id": {
      "$ref": "#/$defs/candidateId"
    },
    "existence_check": {
      "$ref": "#/$defs/existenceCheck"
    },
    "proof_tier": {
      "enum": [
        "T0",
        "T1",
        "T2",
        "T3"
      ]
    },
    "verification_status": {
      "enum": [
        "CONFIRMED",
        "NOT_REPRODUCED",
        "INCONCLUSIVE",
        "DISPROVED",
        "UNPROVEN"
      ]
    },
    "verification_authority": {
      "description": "Controller-stamped provenance for a provider's proof decision. This release exposes no authenticated semantic-oracle authority.",
      "const": "UNAUTHENTICATED_PROVIDER_ASSERTION"
    },
    "disproof_basis": {
      "enum": [
        "falsified-code-premise",
        "validated-oracle"
      ]
    },
    "artifact": {
      "$ref": "#/$defs/artifact"
    },
    "command": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "pre_result": {
      "$ref": "#/$defs/preResult"
    },
    "post_result": {
      "$ref": "#/$defs/postResult"
    },
    "remediation": {
      "$ref": "#/$defs/remediation"
    },
    "reason": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "blocking_reason": {
      "$ref": "#/$defs/nonEmptyString"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "contingent_fact"
        ]
      },
      "then": {
        "properties": {
          "reachable_from": {
            "pattern": "^contingent:.+"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "contingent_query"
        ]
      },
      "then": {
        "properties": {
          "reachable_from": {
            "pattern": "^contingent:.+"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reachable_from": {
            "pattern": "^contingent:.+"
          }
        },
        "required": [
          "reachable_from"
        ]
      },
      "then": {
        "required": [
          "contingent_fact",
          "contingent_query"
        ]
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "required": [
              "effective_severity"
            ]
          },
          {
            "required": [
              "triage_disposition"
            ]
          },
          {
            "required": [
              "drop_reason"
            ]
          },
          {
            "required": [
              "component_finding_ids"
            ]
          },
          {
            "required": [
              "merged_into_candidate_id"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "effective_severity",
          "triage_disposition"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "triage_disposition": {
            "const": "dropped"
          }
        },
        "required": [
          "triage_disposition"
        ]
      },
      "then": {
        "required": [
          "drop_reason"
        ]
      },
      "else": {
        "not": {
          "required": [
            "drop_reason"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "triage_disposition": {
            "const": "merged"
          }
        },
        "required": [
          "triage_disposition"
        ]
      },
      "then": {
        "required": [
          "merged_into_candidate_id"
        ]
      },
      "else": {
        "not": {
          "required": [
            "merged_into_candidate_id"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "triage_disposition": {
            "const": "elevated"
          }
        },
        "required": [
          "triage_disposition"
        ]
      },
      "then": {
        "required": [
          "raised_by"
        ]
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "required": [
              "proof_tier"
            ]
          },
          {
            "required": [
              "verification_status"
            ]
          },
          {
            "required": [
              "artifact"
            ]
          },
          {
            "required": [
              "command"
            ]
          },
          {
            "required": [
              "pre_result"
            ]
          },
          {
            "required": [
              "post_result"
            ]
          },
          {
            "required": [
              "remediation"
            ]
          },
          {
            "required": [
              "reason"
            ]
          },
          {
            "required": [
              "blocking_reason"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "effective_severity",
          "triage_disposition",
          "existence_check",
          "proof_tier",
          "verification_status"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "existence_check": {
            "properties": {
              "status": {
                "const": "not_located"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "existence_check"
        ]
      },
      "then": {
        "properties": {
          "verification_status": {
            "const": "NOT_REPRODUCED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "proof_tier": {
            "const": "T3"
          }
        },
        "required": [
          "proof_tier"
        ]
      },
      "then": {
        "properties": {
          "verification_status": {
            "const": "UNPROVEN"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification_status": {
            "const": "CONFIRMED"
          }
        },
        "required": [
          "verification_status"
        ]
      },
      "then": {
        "properties": {
          "existence_check": {
            "properties": {
              "status": {
                "const": "located"
              }
            }
          },
          "proof_tier": {
            "enum": [
              "T1",
              "T2"
            ]
          },
          "post_result": {
            "properties": {
              "status": {
                "const": "passed"
              }
            }
          }
        },
        "required": [
          "artifact",
          "command",
          "pre_result"
        ],
        "anyOf": [
          {
            "properties": {
              "pre_result": {
                "properties": {
                  "control_status": {
                    "const": "passed"
                  }
                },
                "required": [
                  "control_status"
                ]
              }
            }
          },
          {
            "required": [
              "post_result"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "verification_status": {
            "const": "INCONCLUSIVE"
          }
        },
        "required": [
          "verification_status"
        ]
      },
      "then": {
        "required": [
          "reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "verification_status": {
            "const": "UNPROVEN"
          }
        },
        "required": [
          "verification_status"
        ]
      },
      "then": {
        "required": [
          "blocking_reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "verification_status": {
            "enum": [
              "DISPROVED",
              "NOT_REPRODUCED"
            ]
          }
        },
        "required": [
          "verification_status"
        ]
      },
      "then": {
        "required": [
          "reason"
        ]
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "lens": {
                "const": "database-and-data-stores"
              }
            },
            "required": [
              "lens"
            ]
          },
          {
            "properties": {
              "topic": {
                "pattern": "^(?:database(?:-|$)|db\\.)"
              }
            },
            "required": [
              "topic"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "store_context",
          "principal_path",
          "enforcement_plane",
          "semantic_sensitivity"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "semantic_sensitivity": {
            "enum": [
              "version-sensitive",
              "deployment-sensitive"
            ]
          }
        },
        "required": [
          "semantic_sensitivity"
        ]
      },
      "then": {
        "required": [
          "adapter_rule_id",
          "semantic_source"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "store_context": {
            "properties": {
              "adapter_id": {
                "const": "inventory-only"
              }
            },
            "required": [
              "adapter_id"
            ]
          }
        },
        "required": [
          "store_context"
        ]
      },
      "then": {
        "properties": {
          "effective_severity": {
            "enum": [
              "Medium",
              "Low",
              "Info"
            ]
          },
          "verification_status": {
            "const": "UNPROVEN"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "store_context": {
            "anyOf": [
              {
                "properties": {
                  "engine_version": {
                    "const": "unknown"
                  }
                },
                "required": [
                  "engine_version"
                ]
              },
              {
                "properties": {
                  "deployment_variant": {
                    "const": "unknown"
                  }
                },
                "required": [
                  "deployment_variant"
                ]
              }
            ]
          }
        },
        "required": [
          "store_context"
        ]
      },
      "then": {
        "properties": {
          "effective_severity": {
            "enum": [
              "Medium",
              "Low",
              "Info"
            ]
          },
          "verification_status": {
            "const": "UNPROVEN"
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "\\S"
    },
    "reachableFrom": {
      "$comment": "Three values only: an entry point name, contingent:<entry point name>, or the literal unknown. A near-miss spelling must be rejected here rather than silently bypassing the reachability cap and the contingency disclosure.",
      "allOf": [
        {
          "$ref": "#/$defs/nonEmptyString"
        },
        {
          "oneOf": [
            {
              "const": "unknown"
            },
            {
              "pattern": "^contingent:\\s*\\S"
            },
            {
              "pattern": "^(?![Cc][Oo][Nn][Tt][Ii][Nn][Gg][Ee][Nn][Tt])(?![Uu][Nn][Kk][Nn][Oo][Ww][Nn])\\S"
            }
          ]
        }
      ]
    },
    "boundedEvidenceScalar": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 8192
        },
        {
          "type": [
            "number",
            "boolean",
            "null"
          ]
        }
      ]
    },
    "boundedEvidenceValueDepth3": {
      "anyOf": [
        {
          "$ref": "#/$defs/boundedEvidenceScalar"
        },
        {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/boundedEvidenceScalar"
          }
        },
        {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "$ref": "#/$defs/boundedEvidenceScalar"
          }
        }
      ]
    },
    "boundedEvidenceValueDepth2": {
      "anyOf": [
        {
          "$ref": "#/$defs/boundedEvidenceScalar"
        },
        {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/boundedEvidenceValueDepth3"
          }
        },
        {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "$ref": "#/$defs/boundedEvidenceValueDepth3"
          }
        }
      ]
    },
    "boundedEvidenceValue": {
      "$comment": "Provider-supplied proof state is persisted into the hashed and attested manifest, so it is bounded in breadth and in depth. Unbounded nesting also reaches deepFreeze, cloneJson and isDeepStrictEqual as unguarded recursion.",
      "anyOf": [
        {
          "$ref": "#/$defs/boundedEvidenceScalar"
        },
        {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/boundedEvidenceValueDepth2"
          }
        },
        {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "$ref": "#/$defs/boundedEvidenceValueDepth2"
          }
        }
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "topic": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "candidateId": {
      "type": "string",
      "minLength": 6,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$"
    },
    "sourceAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_id",
        "snapshot_sha256",
        "start_byte",
        "end_byte",
        "excerpt_sha256"
      ],
      "properties": {
        "file_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 80,
          "pattern": "^file_[a-fA-F0-9]{64}$"
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "start_byte": {
          "type": "integer",
          "minimum": 0
        },
        "end_byte": {
          "type": "integer",
          "minimum": 1
        },
        "excerpt_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "findingQuote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line", "text"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "line": { "type": "integer", "minimum": 1 },
        "text": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "absenceClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "kind", "scope"],
      "properties": {
        "pattern": { "type": "string", "minLength": 1, "maxLength": 512 },
        "kind": { "enum": ["literal", "literal_ci"] },
        "scope": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
        }
      }
    },
    "severity": {
      "enum": [
        "Critical",
        "High",
        "Medium",
        "Low",
        "Info"
      ]
    },
    "evidenceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "evidence_class",
        "adapter_id",
        "target_identity",
        "acquisition_mode",
        "acquired_on",
        "detection_evidence",
        "confidence"
      ],
      "properties": {
        "evidence_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "evidence_class": {
          "enum": ["source", "built-artifact", "deployed-state", "live-runtime"]
        },
        "adapter_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "target_identity": { "$ref": "#/$defs/nonEmptyString" },
        "acquisition_mode": { "$ref": "#/$defs/nonEmptyString" },
        "acquired_on": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "detection_evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "confidence": { "enum": ["high", "medium", "low"] }
      }
    },
    "storeContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "store_id",
        "family",
        "engine",
        "engine_version",
        "deployment_variant",
        "adapter_id",
        "detection_evidence",
        "confidence"
      ],
      "properties": {
        "store_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "family": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "engine": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "engine_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "deployment_variant": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "adapter_id": {
          "$ref": "#/$defs/name"
        },
        "detection_evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    },
    "principalPath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authenticated_principal",
        "session_principal",
        "effective_principal",
        "owner_or_definer",
        "bypass_capabilities"
      ],
      "properties": {
        "authenticated_principal": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "session_principal": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "effective_principal": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "owner_or_definer": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "bypass_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "semanticSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "verified_on"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$"
        },
        "verified_on": {
          "type": "string",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
        }
      }
    },
    "existenceCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "method"
      ],
      "properties": {
        "status": {
          "enum": [
            "located",
            "not_located"
          ]
        },
        "method": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "observed": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "preResult": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {
        "$ref": "#/$defs/boundedEvidenceValue"
      },
      "required": [
        "assertion",
        "path_reached",
        "control"
      ],
      "properties": {
        "assertion": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "path_reached": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "control": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "control_status": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "detail": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "postResult": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {
        "$ref": "#/$defs/boundedEvidenceValue"
      },
      "required": [
        "status",
        "regressions"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "regressions": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "detail": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "detail"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOT_ATTEMPTED",
            "FIX_VERIFIED",
            "FIX_FAILED",
            "REGRESSION_FAILED"
          ]
        },
        "detail": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    }
  }
}
