{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://red-team-audit.invalid/schemas/proof-config.schema.json",
  "title": "Proof execution configuration",
  "description": "Names a proof job, provider-authored harness files, bounded attack/control commands, and an optional candidate patch executed in a disposable mirror. Version 1 remains readable; version 2 is the adversarial-validation contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "proof_files",
    "command",
    "destination_guard"
  ],
  "properties": {
    "schema_version": {
      "enum": ["1.0.0", "2.0.0"]
    },
    "job_id": {
      "type": "string",
      "pattern": "^proof-(existence|verification):",
      "maxLength": 256
    },
    "proof_files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "patch_files": {
      "description": "Optional whole-file replacements used to evaluate remediation separately from vulnerability confirmation.",
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "command": {
      "$ref": "#/$defs/command"
    },
    "control_command": {
      "description": "Version 2 command that validates the harness without exercising the attack condition.",
      "$ref": "#/$defs/command"
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "pattern": "^[a-z0-9][a-z0-9._-]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "attack_exit_codes", "control_exit_codes"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "pattern": "^[a-z0-9][a-z0-9._-]+$"
        },
        "attack_exit_codes": { "$ref": "#/$defs/exitCodes" },
        "control_exit_codes": { "$ref": "#/$defs/exitCodes" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_ms", "kill_grace_ms", "max_output_bytes"],
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 3600000
        },
        "kill_grace_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 10485760
        }
      }
    },
    "reproducer": {
      "description": "A concrete proof file retained by digest for deterministic replay.",
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "format"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "format": {
          "enum": ["text", "json", "base64", "test-harness"]
        }
      }
    },
    "destination_guard": {
      "description": "The recorder is in-process and authored by the provider; the controller records the declaration and cannot verify it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installed"
      ],
      "properties": {
        "installed": {
          "type": "boolean"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schema_version": { "const": "2.0.0" } },
        "required": ["schema_version"]
      },
      "then": {
        "required": [
          "strategy",
          "control_command",
          "oracle",
          "limits",
          "reproducer"
        ],
        "properties": {
          "strategy": true,
          "control_command": true,
          "oracle": true,
          "limits": true,
          "reproducer": true,
          "job_id": { "type": "string", "pattern": "^proof-verification:" },
          "destination_guard": {
            "type": "object",
            "properties": { "installed": { "type": "boolean", "const": true } }
          }
        }
      }
    }
  ],
  "$defs": {
    "relativePath": {
      "description": "A mirror-relative, forward-slash lexical path. Leading slash, drive letter, UNC prefix, backslash and parent traversal are all rejected here, and containment is checked again when the file is materialized.",
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(^|/)\\.\\.(/|$))[^\\\\]+$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "contents"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "contents": {
          "type": "string",
          "maxLength": 1048576
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program", "args"],
      "properties": {
        "program": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$",
          "maxLength": 128
        },
        "args": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        }
      }
    },
    "exitCodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    }
  }
}
