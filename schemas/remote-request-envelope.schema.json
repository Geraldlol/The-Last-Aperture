{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://red-team-audit.dev/schemas/remote-request-envelope.schema.json",
  "title": "Red Team Audit signed remote analysis request",
  "description": "A bounded, exact-byte analysis request signed by the controller for one trusted remote gateway.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol",
    "controller",
    "job_packet",
    "artifacts",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "protocol": {
      "const": "remote-gateway-v1"
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "attempt_id",
        "attempt_nonce",
        "created_at",
        "expires_at",
        "run_id",
        "job_id",
        "packet_sha256",
        "plan_sha256",
        "repository_tree_sha256",
        "lens_pack_sha256",
        "policy_sha256",
        "source_snapshot_sha256",
        "control_snapshot_sha256",
        "payload_sha256",
        "prompt_transform",
        "key_id",
        "public_key_spki_base64"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/id"
        },
        "attempt_id": {
          "$ref": "#/$defs/id"
        },
        "attempt_nonce": {
          "$ref": "#/$defs/sha256"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "run_id": {
          "$ref": "#/$defs/id"
        },
        "job_id": {
          "$ref": "#/$defs/id"
        },
        "packet_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "plan_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "repository_tree_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "lens_pack_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_snapshot_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "control_snapshot_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "payload_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "prompt_transform": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "sha256"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "key_id": {
          "type": "string",
          "pattern": "^ed25519:[a-f0-9]{64}$"
        },
        "public_key_spki_base64": {
          "type": "string",
          "minLength": 40,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      }
    },
    "job_packet": {
      "type": "object",
      "required": [
        "run_id",
        "job_id",
        "capability_mode",
        "packet_sha256",
        "scoped_files"
      ],
      "properties": {
        "run_id": {
          "$ref": "#/$defs/id"
        },
        "job_id": {
          "$ref": "#/$defs/id"
        },
        "capability_mode": {
          "const": "STATIC"
        },
        "packet_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "scoped_files": {
          "type": "array",
          "maxItems": 65536,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/logicalFileName"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 65536,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "kind",
        "logical_name",
        "size",
        "sha256",
        "content_base64"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]+$"
        },
        "kind": {
          "enum": [
            "FILE",
            "CONTROL"
          ]
        },
        "logical_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000-\\u001f\\u007f\\\\]+$"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "content_base64": {
          "type": "string",
          "maxLength": 89478488,
          "pattern": "^[A-Za-z0-9+/]*={0,2}$"
        }
      }
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "logicalFileName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u001f\\u007f\\\\]+$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value_base64"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "value_base64": {
          "type": "string",
          "minLength": 88,
          "maxLength": 88,
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      }
    }
  }
}
