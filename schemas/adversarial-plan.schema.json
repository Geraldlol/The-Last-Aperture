{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://red-team-audit.dev/schemas/adversarial-plan.schema.json",
  "title": "The Last Aperture adversarial validation plan",
  "description": "An immutable, strategy-neutral attack/control/oracle plan for a repository, disposable local service, or authorized live target.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "plan_id",
    "engagement_id",
    "scope_revision_sha256",
    "candidate_id",
    "target",
    "strategy_id",
    "risk_class",
    "autonomy_profile",
    "attack",
    "control",
    "oracle",
    "limits"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "red-team-audit/adversarial-plan"
    },
    "plan_id": {
      "$ref": "#/$defs/id"
    },
    "engagement_id": {
      "$ref": "#/$defs/id"
    },
    "scope_revision_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "candidate_id": {
      "$ref": "#/$defs/id"
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "strategy_id": {
      "$ref": "#/$defs/id"
    },
    "strategy_config": {
      "$ref": "#/$defs/json_object"
    },
    "risk_class": {
      "$ref": "#/$defs/risk_class"
    },
    "autonomy_profile": {
      "enum": [
        "L1_ASSISTED",
        "L2_SUPERVISED",
        "L3_MAXIMUM_AUTHORIZED"
      ]
    },
    "attack": {
      "$ref": "#/$defs/attack_or_control"
    },
    "control": {
      "$ref": "#/$defs/attack_or_control"
    },
    "oracle": {
      "$ref": "#/$defs/oracle"
    },
    "limits": {
      "$ref": "#/$defs/limits"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "generator": {
      "$ref": "#/$defs/generator"
    },
    "preflight": {
      "$ref": "#/$defs/preflight"
    },
    "campaign_envelope": {
      "$ref": "#/$defs/campaign_envelope"
    }
  },
  "allOf": [
    {
      "not": {
        "required": [
          "actions",
          "generator"
        ]
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "target": {
                "properties": {
                  "kind": {
                    "const": "live"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            "required": [
              "target"
            ]
          },
          {
            "properties": {
              "autonomy_profile": {
                "enum": [
                  "L1_ASSISTED",
                  "L2_SUPERVISED"
                ]
              }
            },
            "required": [
              "autonomy_profile"
            ]
          }
        ]
      },
      "then": {
        "oneOf": [
          {
            "required": [
              "actions"
            ],
            "not": {
              "required": [
                "generator"
              ]
            }
          },
          {
            "required": [
              "generator"
            ],
            "not": {
              "required": [
                "actions"
              ]
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "autonomy_profile": {
            "const": "L3_MAXIMUM_AUTHORIZED"
          }
        },
        "required": [
          "autonomy_profile"
        ]
      },
      "then": {
        "required": [
          "preflight",
          "campaign_envelope"
        ],
        "properties": {
          "preflight": {
            "properties": {
              "external_scope_enforcement": {
                "const": true
              },
              "impact_classification": {
                "const": true
              },
              "finite_budgets": {
                "const": true
              },
              "target_health_monitoring": {
                "const": true
              },
              "append_only_evidence_capture": {
                "const": true
              },
              "operator_kill_switch": {
                "const": true
              },
              "control_plane_loss_failsafe": {
                "const": true
              },
              "credential_isolation": {
                "const": true
              },
              "cleanup_or_rollback": {
                "const": true
              }
            }
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "campaign_envelope"
          ]
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "human_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "locator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[^\\u0000-\\u0020\\u007f]+$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target_id",
        "locator",
        "identity_sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "repository",
            "local_service",
            "live"
          ]
        },
        "target_id": {
          "$ref": "#/$defs/id"
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "identity_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "risk_class": {
      "enum": [
        "READ_ONLY",
        "STATE_CHANGE",
        "SENSITIVE_DATA",
        "AVAILABILITY_IMPACT",
        "IRREVERSIBLE_CHANGE",
        "PERSISTENCE",
        "LATERAL_MOVEMENT"
      ]
    },
    "attack_or_control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "expected_observation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "$ref": "#/$defs/human_text"
        },
        "expected_observation": {
          "$ref": "#/$defs/human_text"
        }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "confirmation_condition",
        "inconclusive_condition"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "confirmation_condition": {
          "$ref": "#/$defs/human_text"
        },
        "inconclusive_condition": {
          "$ref": "#/$defs/human_text"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_actions",
        "max_wall_time_ms",
        "max_action_time_ms",
        "max_input_bytes",
        "max_output_bytes",
        "max_aggregate_output_bytes",
        "max_concurrency",
        "min_action_interval_ms"
      ],
      "properties": {
        "max_actions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "max_wall_time_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "max_action_time_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900000
        },
        "max_input_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "max_aggregate_output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "max_concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "min_action_interval_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "purpose",
        "action_category",
        "operation",
        "parameters"
      ],
      "properties": {
        "action_id": {
          "$ref": "#/$defs/id"
        },
        "purpose": {
          "enum": [
            "baseline",
            "control",
            "attack",
            "verification",
            "cleanup"
          ]
        },
        "action_category": {
          "$ref": "#/$defs/id"
        },
        "operation": {
          "$ref": "#/$defs/id"
        },
        "parameters": {
          "$ref": "#/$defs/json_object"
        }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generator_id",
        "algorithm",
        "version",
        "generator_sha256",
        "deterministic",
        "seed",
        "max_cases",
        "max_case_bytes",
        "insertion_points",
        "purposes",
        "template"
      ],
      "properties": {
        "generator_id": {
          "$ref": "#/$defs/id"
        },
        "algorithm": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/id"
        },
        "generator_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "deterministic": {
          "const": true
        },
        "seed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~:/+=-]*$"
        },
        "max_cases": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "max_case_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "insertion_points": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "purposes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "baseline",
              "control",
              "attack",
              "verification",
              "cleanup"
            ]
          },
          "allOf": [
            {
              "contains": {
                "const": "control"
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "const": "attack"
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "template": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action_category",
            "operation",
            "parameters"
          ],
          "properties": {
            "action_category": {
              "$ref": "#/$defs/id"
            },
            "operation": {
              "$ref": "#/$defs/id"
            },
            "parameters": {
              "$ref": "#/$defs/json_object"
            }
          }
        }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external_scope_enforcement",
        "impact_classification",
        "finite_budgets",
        "target_health_monitoring",
        "append_only_evidence_capture",
        "operator_kill_switch",
        "control_plane_loss_failsafe",
        "credential_isolation",
        "cleanup_or_rollback"
      ],
      "properties": {
        "external_scope_enforcement": {
          "type": "boolean"
        },
        "impact_classification": {
          "type": "boolean"
        },
        "finite_budgets": {
          "type": "boolean"
        },
        "target_health_monitoring": {
          "type": "boolean"
        },
        "append_only_evidence_capture": {
          "type": "boolean"
        },
        "operator_kill_switch": {
          "type": "boolean"
        },
        "control_plane_loss_failsafe": {
          "type": "boolean"
        },
        "credential_isolation": {
          "type": "boolean"
        },
        "cleanup_or_rollback": {
          "type": "boolean"
        }
      }
    },
    "campaign_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "envelope_id",
        "allowed_operations",
        "allowed_action_categories",
        "allowed_strategy_families",
        "applicability_conditions",
        "decision_rules",
        "max_actions",
        "max_chain_depth",
        "checkpoint_policy",
        "mandatory_escalation_triggers",
        "prohibited_effects"
      ],
      "properties": {
        "envelope_id": {
          "$ref": "#/$defs/id"
        },
        "allowed_operations": {
          "$ref": "#/$defs/id_set"
        },
        "allowed_action_categories": {
          "$ref": "#/$defs/id_set"
        },
        "allowed_strategy_families": {
          "$ref": "#/$defs/id_set"
        },
        "applicability_conditions": {
          "description": "Sealed predicates evaluated against controller-derived candidate facts before a tactical subtarget is eligible.",
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/decision_condition"
          }
        },
        "decision_rules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/decision_rule"
          }
        },
        "max_actions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "max_chain_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "checkpoint_policy": {
          "$ref": "#/$defs/checkpoint_policy"
        },
        "mandatory_escalation_triggers": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "prefixItems": [
            {
              "const": "SCOPE_OR_AUTHORITY_CHANGE"
            },
            {
              "const": "UNEXPECTED_SENSITIVE_OR_THIRD_PARTY_DATA"
            },
            {
              "const": "TARGET_HEALTH_DEGRADATION"
            },
            {
              "const": "LOCKOUT_OR_RESOURCE_EXHAUSTION"
            },
            {
              "const": "IRREVERSIBLE_OR_PERSISTENCE_EFFECT"
            },
            {
              "const": "UNPLANNED_LATERAL_MOVEMENT"
            },
            {
              "const": "OPERATOR_STOP"
            },
            {
              "const": "CONTROL_PLANE_LOSS"
            },
            {
              "const": "AMBIGUOUS_AUTHORIZATION_OR_CLEANUP"
            }
          ],
          "items": false
        },
        "prohibited_effects": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "prefixItems": [
            {
              "const": "SCOPE_EXPANSION"
            },
            {
              "const": "UNEXPECTED_SENSITIVE_DATA_ACCESS"
            },
            {
              "const": "THIRD_PARTY_ACCESS"
            },
            {
              "const": "IRREVERSIBLE_CHANGE"
            },
            {
              "const": "PERSISTENCE"
            },
            {
              "const": "EVIDENCE_DESTRUCTION"
            },
            {
              "const": "UNPLANNED_LATERAL_MOVEMENT"
            },
            {
              "const": "RESOURCE_EXHAUSTION"
            }
          ],
          "items": false
        }
      }
    },
    "id_set": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "checkpoint_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interval_actions",
        "max_resume_count",
        "require_current_authorization",
        "require_runtime_preflight"
      ],
      "properties": {
        "interval_actions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "max_resume_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "require_current_authorization": {
          "const": true
        },
        "require_runtime_preflight": {
          "const": true
        }
      }
    },
    "decision_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "operator",
        "value"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 2,
          "maxLength": 256,
          "pattern": "^/[A-Za-z0-9._~/-]+$"
        },
        "operator": {
          "enum": [
            "equals",
            "not_equals",
            "in",
            "not_in",
            "less_than_or_equal",
            "greater_than_or_equal"
          ]
        },
        "value": {
          "$ref": "#/$defs/json_value"
        }
      }
    },
    "decision_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "when_all",
        "authorize"
      ],
      "properties": {
        "rule_id": {
          "$ref": "#/$defs/id"
        },
        "when_all": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/decision_condition"
          }
        },
        "authorize": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operations",
            "action_categories",
            "strategy_families"
          ],
          "properties": {
            "operations": {
              "$ref": "#/$defs/id_set"
            },
            "action_categories": {
              "$ref": "#/$defs/id_set"
            },
            "strategy_families": {
              "$ref": "#/$defs/id_set"
            }
          }
        }
      }
    },
    "json_object": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/json_value"
      }
    },
    "json_value": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "maxLength": 16384
        },
        {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/json_value"
          }
        },
        {
          "$ref": "#/$defs/json_object"
        }
      ]
    }
  }
}
