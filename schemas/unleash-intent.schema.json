{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://last-aperture.dev/schemas/unleash-intent.schema.json",
  "title": "The Last Aperture target-only campaign intent",
  "description": "The complete Point-Click-Shoot runtime input: one target descriptor.",
  "type": "object",
  "additionalProperties": false,
  "required": ["target"],
  "properties": {
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    }
  }
}
