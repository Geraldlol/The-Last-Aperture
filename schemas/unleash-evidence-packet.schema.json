{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://last-aperture.dev/schemas/unleash-evidence-packet.schema.json",
  "title": "Offline metadata-only evidence packet",
  "description": "A bounded projection that omits all source and receipt content. Local digest validity does not authenticate an exported packet or establish semantic truth.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "plan_sha256", "created_at", "sources", "redaction", "trust", "packet_sha256"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "kind": { "const": "last-aperture/unleash-evidence-packet" },
    "plan_sha256": { "$ref": "#/$defs/sha256" },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "sources": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["evidence_ref", "source_sha256", "source_bytes", "media_type", "receipt_sha256", "verifier_id"],
        "properties": {
          "evidence_ref": { "type": "string", "pattern": "^evidence:sha256:[a-f0-9]{64}$" },
          "source_sha256": { "$ref": "#/$defs/sha256" },
          "source_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
          "media_type": { "enum": ["text/plain", "application/json"] },
          "receipt_sha256": { "$ref": "#/$defs/sha256" },
          "verifier_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$" }
        }
      }
    },
    "redaction": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "payload_values_included"],
      "properties": {
        "mode": { "const": "METADATA_ONLY" },
        "payload_values_included": { "const": false }
      }
    },
    "trust": {
      "type": "object", "additionalProperties": false,
      "required": ["input_authentication", "packet_authenticity", "semantic_authority"],
      "properties": {
        "input_authentication": { "enum": ["CALLBACK_VERIFIED_UNANCHORED", "LOCALLY_HASH_CHAIN_VERIFIED"] },
        "packet_authenticity": { "const": "UNANCHORED" },
        "semantic_authority": { "const": "NONE" }
      }
    },
    "packet_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
