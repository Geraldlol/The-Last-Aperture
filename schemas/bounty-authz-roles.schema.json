{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://red-team-audit.dev/schemas/bounty-authz-roles.schema.json",
  "title": "The Last Aperture bounty-v1 authorization role registry",
  "description": "Roles used to replay captured requests. Credential values are referenced by environment variable name and are never stored in this file, so a registry is safe to commit and a bundle safe to share. There is no property for an inline secret.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "roles"],
  "properties": {
    "schema_version": { "enum": ["1.0.0"] },
    "kind": { "const": "red-team-audit/bounty-authz-roles" },
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "auth"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 128 },
          "auth": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind"],
                "properties": { "kind": { "const": "none" } }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "name", "value_env"],
                "properties": {
                  "kind": { "enum": ["header", "cookie"] },
                  "name": { "type": "string", "minLength": 1, "maxLength": 128 },
                  "value_env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" }
                }
              }
            ]
          }
        }
      }
    }
  }
}
