{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://red-team-audit.dev/schemas/transparency-log-config.schema.json",
  "title": "Red Team Audit transparency log configuration",
  "description": "Trusted controller configuration for publication and optional checkpoint-consistency retrieval from exact HTTPS transparency-log endpoints.",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": { "const": "1.0.0" }
        },
        "required": ["schema_version"]
      },
      "then": {
        "not": { "required": ["consistency_url"] }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": { "const": "1.1.0" }
        },
        "required": ["schema_version"]
      },
      "then": {
        "required": ["consistency_url"]
      }
    }
  ],
  "required": [
    "schema_version",
    "protocol",
    "log_url",
    "log_origin",
    "log_public_key_path",
    "tls_spki_sha256",
    "limits"
  ],
  "properties": {
    "schema_version": {
      "enum": ["1.0.0", "1.1.0"]
    },
    "protocol": {
      "const": "transparency-log-v1"
    },
    "log_url": {
      "type": "string",
      "minLength": 12,
      "maxLength": 2048,
      "pattern": "^https://"
    },
    "consistency_url": {
      "type": "string",
      "minLength": 12,
      "maxLength": 2048,
      "pattern": "^https://"
    },
    "log_origin": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]+$"
    },
    "log_public_key_path": {
      "$ref": "#/$defs/absolutePath"
    },
    "tls_spki_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_timeout_ms",
        "max_clock_skew_ms",
        "max_request_bytes",
        "max_response_bytes"
      ],
      "properties": {
        "request_timeout_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 300000
        },
        "max_clock_skew_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300000
        },
        "max_request_bytes": {
          "type": "integer",
          "minimum": 4096,
          "maximum": 1048576
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 4096,
          "maximum": 1048576
        }
      }
    }
  },
  "$defs": {
    "absolutePath": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4096,
      "pattern": "^(?:/|[A-Za-z]:[\\\\/]|\\\\\\\\[^\\\\/]+[\\\\/][^\\\\/]+)[^\\u0000]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
