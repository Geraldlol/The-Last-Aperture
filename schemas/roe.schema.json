{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://red-team-audit.local/schemas/roe.schema.json",
  "title": "Red Team Audit Rules of Engagement Policy",
  "description": "A dependency-light, machine-readable action policy supplied by the operator outside the repository under audit. This schema is a foundation, not an OWASP APTS conformance claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "mode",
    "workspace_root",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "policy_source": {
      "enum": [
        "default",
        "external"
      ],
      "description": "Trusted control-plane provenance added to normalized policy artifacts."
    },
    "mode": {
      "enum": [
        "static",
        "remote_static",
        "test",
        "local_dynamic"
      ]
    },
    "workspace_root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "Absolute root supplied by the trusted caller. Action paths and capability roots are workspace-relative."
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_file",
        "write_file",
        "execute",
        "network"
      ],
      "properties": {
        "read_file": {
          "$ref": "#/$defs/fileCapability"
        },
        "write_file": {
          "$ref": "#/$defs/fileCapability"
        },
        "execute": {
          "$ref": "#/$defs/executeCapability"
        },
        "network": {
          "$ref": "#/$defs/networkCapability"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "remote_static"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "type": "object",
            "properties": {
              "write_file": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "const": false
                  }
                }
              },
              "execute": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "const": false
                  }
                }
              },
              "network": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "static"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "type": "object",
            "properties": {
              "write_file": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "const": false
                  }
                }
              },
              "execute": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "const": false
                  }
                }
              },
              "network": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "const": false
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "test"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "type": "object",
            "properties": {
              "execute": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              },
              "write_file": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              },
              "network": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "const": false
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "relativeRoot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "A workspace-relative lexical path. Absolute paths and parent traversal are rejected by the policy kernel."
    },
    "fileCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "roots"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "roots": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativeRoot"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "properties": {
              "roots": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "roots": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "commandRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program",
        "args"
      ],
      "properties": {
        "program": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$",
          "maxLength": 128
        },
        "args": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        }
      }
    },
    "executeCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "commands"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "commands": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/commandRule"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "properties": {
              "commands": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "commands": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "networkDestination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "host",
        "ports"
      ],
      "properties": {
        "scheme": {
          "enum": [
            "http",
            "https"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "description": "Exact host only. Wildcards are intentionally unsupported by the foundation policy."
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "path_prefix": {
          "type": "string",
          "pattern": "^/",
          "maxLength": 4096,
          "default": "/"
        }
      }
    },
    "networkCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "destinations"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "destinations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/networkDestination"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "properties": {
              "destinations": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "destinations": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
