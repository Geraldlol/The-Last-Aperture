{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://red-team-audit.dev/schemas/database-conformance-config.schema.json",
  "title": "Trusted database conformance execution configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol",
    "runtime_path",
    "acknowledge_local_dynamic",
    "limits"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "protocol": {
      "const": "docker-database-lab-v1"
    },
    "runtime_path": {
      "$ref": "#/$defs/absolutePath"
    },
    "acknowledge_local_dynamic": {
      "const": true
    },
    "engine_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "postgresql-18.4",
          "mysql-8.4.10"
        ]
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_time_ms",
        "docker_command_timeout_ms",
        "startup_timeout_ms",
        "memory_bytes",
        "cpus",
        "pids",
        "nofile",
        "tmpfs_bytes",
        "max_output_bytes"
      ],
      "properties": {
        "wall_time_ms": {
          "type": "integer",
          "minimum": 60000,
          "maximum": 3600000
        },
        "docker_command_timeout_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        },
        "startup_timeout_ms": {
          "type": "integer",
          "minimum": 10000,
          "maximum": 300000
        },
        "memory_bytes": {
          "type": "integer",
          "minimum": 268435456,
          "maximum": 4294967296
        },
        "cpus": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 4
        },
        "pids": {
          "type": "integer",
          "minimum": 32,
          "maximum": 512
        },
        "nofile": {
          "type": "integer",
          "minimum": 128,
          "maximum": 4096
        },
        "tmpfs_bytes": {
          "type": "integer",
          "minimum": 134217728,
          "maximum": 2147483648
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 67108864
        }
      }
    }
  },
  "$defs": {
    "absolutePath": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4096,
      "pattern": "^(?:/|[A-Za-z]:[\\\\/]|\\\\\\\\[^\\\\/]+[\\\\/][^\\\\/]+)[^\\u0000]*$"
    }
  }
}
