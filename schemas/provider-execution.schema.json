{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://red-team-audit.dev/schemas/provider-execution.schema.json",
  "title": "The Last Aperture controller-observed provider execution",
  "description": "One raw version 1 provider job result paired with a controller-derived byte-delivery receipt. The receipt deliberately makes no claim that semantic analysis occurred.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol",
    "job_result",
    "receipt"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "protocol": {
      "const": "docker-stdio-v1"
    },
    "job_result": {
      "$ref": "https://red-team-audit.dev/schemas/job-result.schema.json"
    },
    "receipt": {
      "$ref": "#/$defs/receipt"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$"
    },
    "opaqueId": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]+$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "absolutePath": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4096,
      "pattern": "^(?:/|[A-Za-z]:[\\\\/]|\\\\\\\\[^\\\\/]+[\\\\/][^\\\\/]+)[^\\u0000]*$"
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "runtime_path",
        "context",
        "image",
        "container_name",
        "container_id",
        "security_profile"
      ],
      "properties": {
        "type": {
          "const": "OCI_DOCKER"
        },
        "runtime_path": {
          "$ref": "#/$defs/absolutePath"
        },
        "runtime_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "context": {
          "const": "default"
        },
        "image": {
          "type": "string",
          "minLength": 71,
          "maxLength": 512
        },
        "container_name": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9_.-]+$"
        },
        "container_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "security_profile": {
          "const": "builtin"
        }
      }
    },
    "deliveredEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "observed_at",
        "bytes_sent",
        "transport_sha256"
      ],
      "properties": {
        "state": {
          "const": "DELIVERED"
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "bytes_sent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "transport_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "consumedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "observed_at",
        "challenge_base64",
        "hmac_algorithm",
        "hmac_domain",
        "challenge_hmac_sha256"
      ],
      "properties": {
        "state": {
          "const": "CONSUMED"
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "challenge_base64": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{43}=$"
        },
        "hmac_algorithm": {
          "const": "HMAC-SHA256"
        },
        "hmac_domain": {
          "const": "red-team-audit/provider-delivery/v1"
        },
        "challenge_hmac_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delivery_id",
        "artifact_id",
        "artifact_kind",
        "logical_name",
        "expected_sha256",
        "size",
        "events"
      ],
      "properties": {
        "delivery_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "artifact_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "artifact_kind": {
          "enum": [
            "FILE",
            "CONTROL"
          ]
        },
        "logical_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "expected_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "events": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "prefixItems": [
                {
                  "$ref": "#/$defs/deliveredEvent"
                }
              ],
              "items": false
            },
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/deliveredEvent"
                },
                {
                  "$ref": "#/$defs/consumedEvent"
                }
              ],
              "items": false
            }
          ]
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "observer",
        "receipt_scope",
        "semantic_analysis_proven",
        "run_id",
        "job_id",
        "packet_sha256",
        "session_id",
        "started_at",
        "completed_at",
        "backend",
        "deliveries",
        "transcript_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "observer": {
          "const": "red-team-audit-controller"
        },
        "receipt_scope": {
          "const": "BYTE_DELIVERY_AND_CHALLENGE_CONSUMPTION_ONLY"
        },
        "semantic_analysis_proven": {
          "const": false
        },
        "run_id": {
          "$ref": "#/$defs/id"
        },
        "job_id": {
          "$ref": "#/$defs/id"
        },
        "packet_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "session_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "started_at": {
          "$ref": "#/$defs/timestamp"
        },
        "completed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "backend": {
          "$ref": "#/$defs/backend"
        },
        "deliveries": {
          "type": "array",
          "maxItems": 65536,
          "items": {
            "$ref": "#/$defs/delivery"
          }
        },
        "transcript_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
