{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://red-team-audit.dev/schemas/job-result.schema.json",
  "title": "Red Team Audit provider job result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "job_id",
    "input_sha256",
    "producer",
    "state",
    "examined_files",
    "findings",
    "coverage_gaps"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "$ref": "#/$defs/id"
    },
    "job_id": {
      "$ref": "#/$defs/id"
    },
    "state": {
      "enum": [
        "SUCCEEDED",
        "FAILED"
      ]
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "instance_id"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "instance_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "examined_files": {
      "type": "array",
      "maxItems": 65536,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "https://red-team-audit.dev/schemas/finding.schema.json"
      }
    },
    "coverage_gaps": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "area",
          "reason"
        ],
        "properties": {
          "area": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "reason": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "topic_assessments": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/topicAssessment"
      }
    },
    "store_profiles": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "https://red-team-audit.dev/schemas/store-profile.schema.json"
      }
    },
    "store_contributions": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "https://red-team-audit.dev/schemas/store-contribution.schema.json"
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "recoverable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$"
        },
        "message": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "recoverable": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "FAILED"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "error"
        ],
        "properties": {
          "findings": {
            "maxItems": 0
          },
          "store_profiles": {
            "maxItems": 0
          },
          "store_contributions": {
            "maxItems": 0
          },
          "topic_assessments": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "error"
          ]
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "\\S"
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$"
    },
    "topicAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic",
        "disposition",
        "reason"
      ],
      "properties": {
        "topic": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "disposition": {
          "enum": [
            "finding",
            "examined-clean",
            "partial",
            "not-applicable",
            "not-assessed"
          ]
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "evidence_paths": {
          "type": "array",
          "maxItems": 65536,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "finding_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "coverage_gap_areas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "finding"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "required": [
              "finding_ids"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "enum": [
                  "examined-clean",
                  "not-applicable"
                ]
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "required": [
              "evidence"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "partial"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "required": [
              "evidence",
              "coverage_gap_areas"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "not-assessed"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "required": [
              "coverage_gap_areas"
            ]
          }
        }
      ]
    }
  }
}
