{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://red-team-audit.dev/schemas/database-conformance-evidence.schema.json",
  "title": "Red Team Audit disposable database reference evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "assurance_scope",
    "target_deployment_proven",
    "root_authenticity",
    "source",
    "engines"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "red-team-audit/database-conformance-evidence"
    },
    "assurance_scope": {
      "const": "CONTROLLER_OBSERVED_DISPOSABLE_ENGINE_BEHAVIOR"
    },
    "target_deployment_proven": {
      "const": false
    },
    "root_authenticity": {
      "const": "UNANCHORED"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "state",
        "root_sha256",
        "created_at",
        "completed_at"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 24,
          "maxLength": 160,
          "pattern": "^db-lab:[0-9TZ.:-]+:[a-f0-9]{12}$"
        },
        "state": {
          "const": "COMPLETE"
        },
        "root_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "completed_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "engines": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "engine_id",
          "adapter_id",
          "product",
          "server_version",
          "requested_image",
          "image_id",
          "result_sha256",
          "state",
          "scenarios"
        ],
        "properties": {
          "engine_id": {
            "enum": [
              "postgresql-18.4",
              "mysql-8.4.10"
            ]
          },
          "adapter_id": {
            "enum": [
              "postgresql",
              "mysql"
            ]
          },
          "product": {
            "enum": [
              "PostgreSQL",
              "MySQL"
            ]
          },
          "server_version": {
            "$ref": "#/$defs/text"
          },
          "requested_image": {
            "type": "string",
            "minLength": 72,
            "maxLength": 512,
            "pattern": "^[a-z0-9][a-z0-9._/-]*@sha256:[a-f0-9]{64}$"
          },
          "image_id": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "result_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "state": {
            "const": "PASSED"
          },
          "scenarios": {
            "type": "array",
            "minItems": 8,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scenario_id",
                "state",
                "adapter_rule_ids"
              ],
              "properties": {
                "scenario_id": {
                  "$ref": "#/$defs/id"
                },
                "state": {
                  "const": "PASSED"
                },
                "adapter_rule_ids": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 160,
                    "pattern": "^db\\.[a-z0-9.-]+$"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z0-9][a-z0-9._:-]+$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    }
  }
}
