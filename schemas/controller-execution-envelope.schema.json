{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://red-team-audit.dev/schemas/controller-execution-envelope.schema.json",
  "title": "Red Team Audit signed controller execution envelope",
  "description": "One provider execution and byte-consumption receipt bound to a durable controller attempt and signed with an external Ed25519 key.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority",
    "controller",
    "provider_execution",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "authority": {
      "const": "CONTROLLER_OBSERVED_CONSUMPTION"
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "attempt_nonce",
        "lease_event_sha256",
        "packet_sha256",
        "source_snapshot_sha256",
        "control_snapshot_sha256",
        "signed_at",
        "key_id",
        "public_key_spki_base64",
        "provider_execution_sha256",
        "receipt_sha256"
      ],
      "properties": {
        "attempt_id": {
          "$ref": "#/$defs/id"
        },
        "attempt_nonce": {
          "$ref": "#/$defs/sha256"
        },
        "lease_event_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "packet_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_snapshot_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "control_snapshot_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "signed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "key_id": {
          "type": "string",
          "pattern": "^ed25519:[a-f0-9]{64}$"
        },
        "public_key_spki_base64": {
          "type": "string",
          "minLength": 40,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        },
        "provider_execution_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "receipt_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "provider_execution": {
      "$ref": "https://red-team-audit.dev/schemas/provider-execution.schema.json"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value_base64"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "value_base64": {
          "type": "string",
          "minLength": 88,
          "maxLength": 88,
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    }
  }
}
