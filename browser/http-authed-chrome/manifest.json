{
  "manifest_version": 3,
  "name": "Red Team Audit Browser Bridge",
  "version": "0.12.0",
  "description": "Runs one explicitly committed same-origin request through an operator-selected tab without exporting browser-held authentication.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Red Team Audit browser bridge",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
