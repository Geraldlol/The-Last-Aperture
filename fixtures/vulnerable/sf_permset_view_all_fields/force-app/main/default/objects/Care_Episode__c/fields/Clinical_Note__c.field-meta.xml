<?xml version="1.0" encoding="UTF-8"?>
<!--
  Supporting artifact for V-013, not a fixture of its own and not counted as one.
  It carries no defect and no data — a field definition holds no records.

  This is the field neither permission set in this directory grants through
  <fieldPermissions>. Under field-level security its holders read
  Episode_Status__c and nothing else. Care_Coordination_Team reads this field
  anyway, because viewAllFields covers every field on the object including the
  ones nobody granted.

  It is described as a clinical note so that the field's sensitivity is not in
  doubt while grading. No note text exists anywhere in this corpus.
-->
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Clinical_Note__c</fullName>
    <label>Clinical Note</label>
    <description>Free-text clinical narrative. Restricted to the treating clinician by field-level security.</description>
    <type>LongTextArea</type>
    <length>32768</length>
    <visibleLines>10</visibleLines>
    <required>false</required>
    <trackHistory>false</trackHistory>
</CustomField>
