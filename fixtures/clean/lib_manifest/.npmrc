# C-023 (part 2 of 2) — clean fixture. Expected findings at Low or above: ZERO.
#
# `registry=` is present, which is one of the literals the dependency-resolution
# sweep looks for. It points at the PUBLIC registry, which is where this package's
# dependencies come from, and there is no `@scope:registry` line pointing a private
# scope at a public host and no `extra-index-url`-style second source — so there is
# no dependency-confusion shape here.
#
# `ignore-scripts=true` is the value the lifecycle-script check needs. A grep that
# only asks whether the KEY is present cannot tell this from `ignore-scripts=false`,
# which is the legal opt-out.
#
# Note the known cost, recorded rather than hidden: `ignore-scripts=true` breaks
# packages that need a native build or a browser download. This library has neither
# (its two dependencies are pure ESM), which is why the setting is affordable here
# and why it is not a blanket recommendation.

registry=https://registry.npmjs.org/
ignore-scripts=true
audit=true
fund=false

# Frozen installs in CI. `pnpm install --frozen-lockfile` is the equivalent of
# `npm ci`; the lockfile lives at the workspace root, which is what a library's own
# CI reads and what a consumer never does.
prefer-frozen-lockfile=true
